{
  "compilerOptions": {
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "target": "es2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "build",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "types": [
      "@cloudflare/workers-types/2023-07-01"
    ]
  },
  "include": [
    "worker-configuration.d.ts",
    "src/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
